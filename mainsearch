<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Imperisearch - Privát Kereső</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: sans-serif; }
        body { background-color: #0d1117; color: #c9d1d9; min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 20px; }
        .container { width: 100%; max-width: 600px; text-align: center; }
        h1 { font-size: 3rem; margin-bottom: 25px; color: #ff4757; font-weight: bold; letter-spacing: -1px; }
        .search-box { display: flex; background-color: #161b22; border: 2px solid #30363d; border-radius: 50px; padding: 6px 20px; margin-bottom: 20px; }
        .search-input { flex: 1; background: none; border: none; outline: none; color: #f0f6fc; font-size: 1.2rem; padding: 10px 0; }
        .search-button { background: none; border: none; color: #8b949e; cursor: pointer; font-size: 1.3rem; }
        .info-text { font-size: 0.9rem; color: #8b949e; margin-top: 10px; }
    </style>
</head>
<body>

    <div class="container">
        <h1>imperisearch</h1>
        
        <form onsubmit="inditKereses(event)">
            <div class="search-box">
                <input type="text" id="keresoMezo" class="search-input" placeholder="Biztonságos, privát keresés..." autofocus autocomplete="off">
                <button type="submit" class="search-button">🔍</button>
            </div>
        </form>
        
        <p class="info-text">Teljesen privacy alapú indítóoldal.</p>
    </div>

    <script>
        function inditKereses(event) {
            event.preventDefault();
            const szo = document.getElementById('keresoMezo').value.trim();
            if (!szo) return;

            // A DuckDuckGo reklám- és követésmentes privát verziójára dob át azonnal
            const url = "https://duckduckgo.com" + encodeURIComponent(szo) + "&kp=-1&kh=-1&kl=hu-hu";
            window.location.href = url;
        }
    </script>

</body>
</html>
